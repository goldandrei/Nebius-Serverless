# Nebius credentials — copy to .env, fill in real values, NEVER commit .env
NEBIUS_PROJECT_ID=
NEBIUS_REGION=eu-north1
NEBIUS_SUBNET_ID=

# API key + base URL for live inference, embedding, and judge scoring (Token Factory)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional: Hugging Face token (needed for gated models)
HF_TOKEN=

# Optional: judge model for llm_judge tasks — defaults to deepseek-ai/DeepSeek-V4-Pro if unset
JUDGE_MODEL=
