# Nebius credentials — copy to .env, fill in real values, NEVER commit .env
NEBIUS_PROJECT_ID=
NEBIUS_REGION=eu-north1
NEBIUS_SUBNET_ID=

# API key for live inference and embedding (Nebius AI Studio)
NEBIUS_API_KEY=

# Optional: Hugging Face token (needed for gated models)
HF_TOKEN=

# Local vLLM server (--backend local)
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Object Storage (S3-compatible) — from Nebius console > Access keys
STORAGE_BUCKET=
STORAGE_ENDPOINT=https://storage.eu-north1.nebius.cloud
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
